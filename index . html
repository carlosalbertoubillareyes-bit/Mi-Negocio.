<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Mi Negocio - POS</title>
    <style>
        :root {
            --bg: #eef2f1;
            --card: #fff;
            --ink: #14262b;
            --mut: #5d7176;
            --line: #d5dedd;
            --pri: #0f766e;
            --pri-ink: #fff;
            --acc: #f2b705;
            --acc-ink: #14262b;
            --bad: #b42318;
            --ok: #067647;
            --shadow: rgba(0, 0, 0, 0.05);
        }
        @media(prefers-color-scheme: dark) {
            :root {
                --bg: #0f1b1e;
                --card: #172629;
                --ink: #e8f0ef;
                --mut: #93a8ad;
                --line: #27393d;
                --pri: #2dd4bf;
                --pri-ink: #06201d;
                --bad: #f97066;
                --ok: #47cd89;
                --shadow: rgba(0, 0, 0, 0.3);
            }
        }
        * { box-sizing: border-box; transition: background-color 0.2s, border-color 0.2s; }
        body {
            margin: 0;
            background: var(--bg);
            color: var(--ink);
            font: 16px/1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            padding-bottom: 90px;
        }
        header {
            padding: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--card);
            border-bottom: 1px solid var(--line);
        }
        header h1 { font-size: 20px; margin: 0; }
        main { padding: 16px 12px; max-width: 720px; margin: auto; }
        .card {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 16px;
            box-shadow: 0 2px 4px var(--shadow);
        }
        h2 { font-size: 15px; margin: 0 0 12px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--mut); }
        input, select, button { font: inherit; color: inherit; }
        input, select {
            width: 100%;
            padding: 12px;
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--bg);
            margin-bottom: 8px;
        }
        input:focus, select:focus { outline: 2px solid var(--pri); }
        button {
            border: 0;
            border-radius: 8px;
            padding: 12px 16px;
            background: var(--pri);
            color: var(--pri-ink);
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        button:hover { opacity: 0.9; }
        button:active { transform: scale(0.98); }
        button:disabled { opacity: .4; cursor: not-allowed; transform: none; }
        button.sec { background: transparent; color: var(--ink); border: 1px solid var(--line); }
        button.sec:hover { background: var(--bg); }
        button.cobrar { background: var(--acc); color: var(--acc-ink); width: 100%; font-size: 18px; padding: 16px; }
        button.x { background: transparent; color: var(--bad); padding: 8px; font-size: 18px; }
        button.x:hover { background: rgba(180, 35, 24, 0.1); }
        .row { display: flex; gap: 8px; align-items: center; }
        .row>* { flex: 1; margin: 0; }
        .row .fit { flex: 0 0 auto; }
        .item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid var(--line);
        }
        .item:last-child { border-bottom: 0; }
        .empty-state { text-align: center; color: var(--mut); padding: 24px 0; }
        
        /* Modal nativo para cobros */
        dialog {
            border: 1px solid var(--line);
            border-radius: 12px;
            background: var(--card);
            color: var(--ink);
            padding: 24px;
            max-width: 400px;
            width: 100%;
        }
        dialog::backdrop { background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); }
    </style>
</head>
<body>

    <header>
        <h1>🛒 Mi Negocio</h1>
        <button class="sec" onclick="alert('Historial próximamente')">Historial</button>
    </header>

    <main>
        <!-- Agregar Producto Rápido -->
        <div class="card">
            <h2>Añadir al Carrito</h2>
            <form id="prod-form" class="row" onsubmit="agregarProducto(event)">
                <select id="prod-select" required>
                    <option value="" disabled selected>Selecciona un producto...</option>
                    <option value="1500" data-nombre="Bebida Familiar">Bebida Familiar (\$1.500)</option>
                    <option value="4000" data-nombre="Aceite de Oliva">Aceite de Oliva (\$4.000)</option>
                    <option value="850" data-nombre="Pan Hallulla KG">Pan Hallulla KG (\$850)</option>
                    <option value="1200" data-nombre="Leche Entera 1L">Leche Entera 1L (\$1.200)</option>
                </select>
                <button type="submit" class="fit">＋ Agregar</button>
            </form>
        </div>

        <!-- Carrito de Compras -->
        <div class="card">
            <h2>Detalle de la Venta</h2>
            <div id="carrito-lista">
                <!-- Se llena dinámicamente con JS -->
            </div>
        </div>

        <!-- Total y Acción Principal -->
        <div class="card" style="margin-bottom: 0;">
            <div class="item" style="font-size: 22px; font-weight: 800; border: none;">
                <span>Total a Pagar:</span>
                <span id="total-pago">\$0</span>
            </div>
            <button id="btn-cobrar" class="cobrar" onclick="abrirCaja()" disabled>💳 Procesar Cobro</button>
        </div>
    </main>

    <!-- Modal de Cierre de Caja -->
    <dialog id="modal-caja">
        <h3 style="margin-top:0">Resumen de Venta</h3>
        <p>Total cobrado: <strong id="modal-total" style="color:var(--ok)"></strong></p>
        <p style="font-size: 14px; color:var(--mut)">¿Deseas confirmar el pago y registrar la venta?</p>
        <div class="row" style="margin-top: 20px;">
            <button class="sec" onclick="document.getElementById('modal-caja').close()">Cancelar</button>
            <button onclick="finalizarVenta()" style="background:var(--ok); color:white;">✔ Confirmar</button>
        </div>
    </dialog>

    <script>
        // Estado de la app
        let carrito = [];

        function renderCarrito() {
            const lista = document.getElementById('carrito-lista');
            const btnCobrar = document.getElementById('btn-cobrar');
            const totalPago = document.getElementById('total-pago');
            
            if (carrito.length === 0) {
                lista.innerHTML = `<div class="empty-state">El carrito está vacío. Agrega un producto arriba.</div>`;
                btnCobrar.disabled = true;
                totalPago.innerText = '\$0';
                return;
            }

            btnCobrar.disabled = false;
            lista.innerHTML = '';
            let total = 0;

            carrito.forEach((item, index) => {
                const subtotal = item.precio * item.cantidad;
                total += subtotal;

                lista.innerHTML += `
                    <div class="item">
                        <div>
                            <div><strong>${item.nombre}</strong></div>
                            <small style="color:var(--mut)">$${item.precio.toLocaleString()} x ${item.cantidad}</small>
                        </div>
                        <div class="row fit">
                            <span style="font-weight:600">$${subtotal.toLocaleString()}</span>
                            <button class="x" onclick="eliminarItem(${index})">✕</button>
                        </div>
                    </div>
                `;
            });

            totalPago.innerText = `$${total.toLocaleString()}`;
        }

        function agregarProducto(e) {
            e.preventDefault();
            const select = document.getElementById('prod-select');
            if (!select.value) return;

            const precio = parseInt(select.value);
            const nombre = select.options[select.selectedIndex].getAttribute('data-nombre');

            // Si ya existe en el carrito, sumar cantidad
            const existente = carrito.find(item => item.nombre === nombre);
            if (existente) {
                existente.cantidad++;
            } else {
                carrito.push({ nombre, precio, cantidad: 1 });
            }

            select.selectedIndex = 0; // Reset select
            renderCarrito();
        }

        function eliminarItem(index) {
            carrito.splice(index, 1);
            renderCarrito();
        }

        function abrirCaja() {
            const total = document.getElementById('total-pago').innerText;
            document.getElementById('modal-total').innerText = total;
            document.getElementById('modal-caja').showModal();
        }

        function finalizarVenta() {
            alert('¡Venta registrada con éxito!');
            carrito = [];
            document.getElementById('modal-caja').close();
            renderCarrito();
        }

        // Inicializar vista vacía
        renderCarrito();
    </script>
</body>
</html>

